# ---------------------------------------------------------------
# CM App Backend — Environment Variables
# Copy this file to .env and fill in real values before starting.
# Never commit .env — it is in .gitignore.
# ---------------------------------------------------------------

# ── Server ──────────────────────────────────────────────────────
PORT=3000

# ── JWT ─────────────────────────────────────────────────────────
# All token types (admin, pro_app, pro_web, pro_staff) are signed
# with this secret. Use a long random string (32+ chars).
JWT_SECRET=replace_with_a_long_random_secret

# ── Admin credentials ───────────────────────────────────────────
# Checked at /api/auth/admin-login. Not stored in the DB.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password

# ── Supabase ────────────────────────────────────────────────────
# Found in: Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ── Razorpay (platform-level, for admin webhook verification) ───
# Found in: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Found in: Razorpay Dashboard → Settings → Webhooks → Webhook secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Email (Resend) ──────────────────────────────────────────────
# Used for OTP emails. Found in: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Encryption ──────────────────────────────────────────────────
# AES-256 key for encrypting payment gateway credentials at rest.
# Must be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENC_KEY=replace_with_64_hex_chars

# ── AI Assistant (Anthropic) ────────────────────────────────────
# Found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Model to use for the assistant. Defaults to claude-haiku if unset.
ASSISTANT_MODEL=claude-haiku-4-5-20251001

# ── Cron (optional) ─────────────────────────────────────────────
# Secret required to call /api/auth/cron/run-rollovers externally.
# Only needed if triggering rollovers from an external scheduler.
CRON_SECRET=replace_with_random_secret
